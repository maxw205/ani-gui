{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AnimeCLI",
  "version": "0.1.0",
  "identifier": "com.maxw205.animecli",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AnimeCLI",
        "width": 1180,
        "height": 760,
        "minWidth": 880,
        "minHeight": 560,
        "backgroundColor": "#15161c"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://s4.anilist.co; connect-src 'self' ipc: http://ipc.localhost https://graphql.anilist.co"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
